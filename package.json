{
  "name": "mylog-desktop-notifier",
  "version": "1.2.0",
  "author": "ixu",
  "description": "MyLog 桌面通知代理 - 系统级来电/消息提醒",
  "main": "main.js",
  "scripts": {
    "dev": "scripts\\start.bat",
    "dev:mac": "bash scripts/start.sh",
    "build": "node build.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win && rm -rf dist-installer-new/win-unpacked",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.tianyuan.mylog.desktop-notifier",
    "productName": "我的日志_桌面通知",
    "artifactName": "${productName} 安装包 ${version}.${ext}",
    "copyright": "Copyright (c) 2025 tianyuan",
    "asar": true,
    "asarUnpack": [
      "assets/**/*"
    ],
    "directories": {
      "output": "dist-installer-new"
    },
    "files": [
      "main.js",
      "config.js",
      "lib/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/.git/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "${productName} 安装包 ${version}.${ext}",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "title": "我的日志",
      "icon": "assets/icon.png",
      "iconSize": 80,
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "我的日志_桌面通知",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "26.15.3",
    "jimp": "0.22.12"
  }
}
